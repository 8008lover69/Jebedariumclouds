// JebedariumClouds - native EVE-Redux raymarched volumetric clouds.
// Written against the exact schema of the installed Atmosphere.dll
// (EVE Redux, Assembly version 2.3.3.0, raymarched-volumetrics branch),
// verified field-by-field via reflection - NOT copied from a newer/older
// EVE build's example configs. Uses this mod's own textures/sounds only.

EVE_CLOUDS
{
	OBJECT
	{
		name = Kerbin-base-layer
		body = Kerbin
		altitude = 2200
		detailSpeed = 0,6,0
		speed = 0,29.89,0
		settings
		{
			_Color = 512,512,512,255
			_MainTex
			{
				value = JebedariumClouds/Textures/Kerbin/scaled
				isClamped = True
			}
			_BumpMap
			{
				value = JebedariumClouds/Textures/Kerbin/normals
				isClamped = True
			}
			_BumpScale = 0.5
			_DetailTex
			{
				value = JebedariumClouds/Textures/common/detail
			}
			_UVNoiseTex
			{
				value = JebedariumClouds/Textures/common/uvnoise
			}
			_DetailScale = 30
			_UVNoiseStrength = 0.0002
