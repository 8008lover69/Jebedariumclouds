			raymarchingSettings
			{
				lightMarchSteps = 4
				lightMarchDistance = 1200
				baseStepSize = 75
				adaptiveStepSizeFactor = 0.006
				maxStepSize = 1500
			}
			noise
			{
				worley
				{
					octaves = 3
